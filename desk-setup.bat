@echo off
rem INMUU practice room booking PC (internet): desktop + startup shortcut (Chrome app window, full screen; Edge only if Chrome is missing)
rem target: https://headoffice-inmuu.github.io/inmuu-room/desk.html
rem 2026-10-26: Chrome is the default browser for booking PCs (register the PC in Chrome too)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$u='https://headoffice-inmuu.github.io/inmuu-room/desk.html'; $c=@((Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\chrome.exe' -ErrorAction SilentlyContinue).'(default)', (Get-ItemProperty 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\chrome.exe' -ErrorAction SilentlyContinue).'(default)', ($env:ProgramFiles+'\Google\Chrome\Application\chrome.exe'), (${env:ProgramFiles(x86)}+'\Google\Chrome\Application\chrome.exe'), ($env:LOCALAPPDATA+'\Google\Chrome\Application\chrome.exe')) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1; if(-not $c){ $c=(Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\msedge.exe' -ErrorAction SilentlyContinue).'(default)'; if(-not $c){$c='C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'}; Write-Host 'Chrome not found - using Edge' } else { Write-Host 'Using Chrome' }; $n=-join([char[]]@(0xC778,0xC0DD,0xBBA4,0xC9C1,0x20,0xC5F0,0xC2B5,0xC2E4,0x20,0xC608,0xC57D)); $a='--app='+$u+' --start-fullscreen --no-first-run'; $w=New-Object -ComObject WScript.Shell; foreach($p in @([Environment]::GetFolderPath('Desktop'),[Environment]::GetFolderPath('Startup'))){ $s=$w.CreateShortcut((Join-Path $p ($n+'.lnk'))); $s.TargetPath=$c; $s.Arguments=$a; $s.Save() }; Start-Process $c $a"
echo.
echo Done. Desktop and startup shortcuts were created.
pause
